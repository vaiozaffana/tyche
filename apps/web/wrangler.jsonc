{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tyche-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "secrets": {
    "required": ["GEMINI_API_KEY"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "dev": {
    "port": 3000,
  },
}
